<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Modulo di riscrittura URL per le Single Page Application (React/Vite) -->
    <rewrite>
      <rules>
        <rule name="React Router Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Se la richiesta è un file fisico (es. un'immagine, un JS, un CSS), servilo normalmente -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Se la richiesta è una cartella fisica, servila normalmente -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Per tutto il resto (es. /clienti/hotel-labussola), restituisci index.html e lascia fare a React -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Ottimizzazione opzionale: abilita la compressione per i file di testo (JS, CSS, JSON) -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    
    <!-- Gestione MIME type per i file JSON (utile per il tuo config.json) -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>

